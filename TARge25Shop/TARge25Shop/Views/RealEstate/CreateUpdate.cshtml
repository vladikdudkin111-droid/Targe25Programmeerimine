@model TARge25Shop.Models.RealEstate.RealEstateCreateUpdateViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Update" : "Create";
}
<h1>@ViewData["Title"]</h1>

@* Põhivorm saadab muudetavad väljad ja valitud uued failid. *@
<form asp-controller="RealEstate" asp-action="@(Model.Id.HasValue ? "Update" : "Create")"
      method="post" enctype="multipart/form-data" asp-antiforgery="true">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group row mb-3">
        <label asp-for="Area" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Area" type="number" step="0.01" min="0.01" class="form-control" />
            <span asp-validation-for="Area" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label asp-for="Location" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Location" class="form-control" />
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label asp-for="RoomNumber" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="RoomNumber" type="number" step="1" min="0" class="form-control" />
            <span asp-validation-for="RoomNumber" class="text-danger"></span>
        </div>
    </div>
    <div class="form-group row mb-3">
        <label asp-for="BuildingType" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="BuildingType" class="form-control" />
            <span asp-validation-for="BuildingType" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Files"></label>
        <input asp-for="Files" multiple type="file" accept=".jpg,.jpeg,.png,.gif,.webp" class="form-control" />
        <span asp-validation-for="Files" class="text-danger"></span>
        <div class="form-text">JPG, PNG, GIF või WEBP. Kuni 5 uut pilti, igaüks kuni 5 MB.</div>
        <div class="form-text">Olemasolevad pildid säilivad. Vormi vea järel vali uued failid uuesti.</div>
    </div>
    <button type="submit" class="btn btn-success">@(Model.Id.HasValue ? "Update" : "Create")</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@* Eraldi POST-vorm ei saada pooleliolevaid muudatusi ega vaja põhivormi valideerimist. *@
@if (Model.Image.Count > 0)
{
    <h2 class="mt-4">Images</h2>
    <div class="row g-3">
        @foreach (var image in Model.Image)
        {
            <div class="col-sm-6 col-lg-4">
                <partial name="_Images" model="image" />
                <form asp-controller="RealEstate" asp-action="RemoveImage" method="post" asp-antiforgery="true">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="imageId" value="@image.ImageId" />
                    <button type="submit" class="btn btn-outline-danger mt-2">Remove Image</button>
                </form>
            </div>
        }
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
