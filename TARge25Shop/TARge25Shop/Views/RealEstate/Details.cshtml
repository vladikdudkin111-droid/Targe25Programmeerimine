@model TARge25Shop.Models.RealEstate.RealEstateDetailsViewModel
<h1>Details</h1>
<h4>RealEstate</h4>
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Id)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Id)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Area)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Area)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Location)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Location)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.RoomNumber)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.RoomNumber)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.BuildingType)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.BuildingType)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CreatedAt)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.CreatedAt)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ModifiedAt)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.ModifiedAt)</dd>
</dl>
@* Sama pildi osavaade teenindab üksikasjade ja kustutamise lehte. *@
<div class="row g-3 mb-3">
    @foreach (var image in Model.Image)
    {
        <div class="col-sm-6 col-lg-4"><partial name="_Images" model="image" /></div>
    }
</div>
<a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-primary">Update</a>
<a asp-action="Index" class="btn btn-secondary">Back</a>
