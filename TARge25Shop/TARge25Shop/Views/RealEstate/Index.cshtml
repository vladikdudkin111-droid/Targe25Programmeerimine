@model IEnumerable<TARge25Shop.Models.RealEstate.RealEstateIndexViewModel>

@{
    // Reanumber on ainult kuvamiseks; tegeliku kirje määrab Guid Id.
    ViewData["Title"] = "Real estate";
    var rowNumber = 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Real estate</h1>
    <a asp-action="Create" class="btn btn-primary">Create</a>
</div>

@if (!Model.Any())
{
    @* Tühi andmebaasitabel on tavaline olukord enne esimese objekti loomist. *@
    <p>No properties yet. Select Create to add one.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th scope="col">Nr</th>
                    <th scope="col">Address</th>
                    <th scope="col">Area (m²)</th>
                    <th scope="col">Rooms</th>
                    <th scope="col">Price (€)</th>
                    <th scope="col">Created</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var realEstate in Model)
                {
                    <tr>
                        <td>@rowNumber</td>
                        <td>@realEstate.Address</td>
                        <td>@realEstate.Area.ToString("0.00")</td>
                        <td>@realEstate.RoomCount</td>
                        <td>@realEstate.Price.ToString("0.00")</td>
                        <td>@realEstate.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="text-nowrap">
                            @* Iga link saadab tegevusele selle rea objekti ID. *@
                            <a asp-action="Details" asp-route-id="@realEstate.Id" class="btn btn-sm btn-primary">Details</a>
                            <a asp-action="Update" asp-route-id="@realEstate.Id" class="btn btn-sm btn-primary">Update</a>
                            <a asp-action="Delete" asp-route-id="@realEstate.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        </td>
                    </tr>
                    rowNumber++;
                }
            </tbody>
        </table>
    </div>
}
