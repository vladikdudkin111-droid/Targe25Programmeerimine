@model TARge25Shop.Models.Spaceship.ImageViewModel
@{
    // Kasutame salvestatud failinime, et moodustada wwwroot suhteline aadress.
    var photoPath = "~/multipleFileUpload/" + Model.FilePath;
}
<div class="card">
    @if (!string.IsNullOrEmpty(Model.FilePath))
    {
        <img src="@photoPath" asp-append-version="true" class="card-img-top"
             alt="Spaceship image" style="max-height: 260px; object-fit: contain;" />
    }
    <div class="card-body"><p class="card-text text-break">@Model.FilePath</p></div>
</div>
