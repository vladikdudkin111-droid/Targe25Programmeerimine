@model TARge25Shop.Models.Spaceship.ImageViewModel

@{
    // Failinimi lisatakse wwwroot/multipleFileUpload avalikule veebiteele.
    // Puuduva failinime korral kasutatakse õpetaja näite järgi noimage.jpg nime.
    var photoPath = "~/multipleFileUpload/" + (Model.FilePath ?? "noimage.jpg");
}

<!-- Partial kuvab ühe üleslaaditud faili nime ja pildi. -->
<div class="col-sm-4 mb-3">
    <div class="card h-100">
        <img class="card-img-top" src="@photoPath" asp-append-version="true" alt="Spaceship image" />
        <div class="card-body">
            <small class="text-muted">@Model.FilePath</small>
        </div>
    </div>
</div>
