@model TARge25Shop.Models.Spaceship.SpaceshipCreateViewModel
@{
    // Lehe pealkiri brauseris.
    ViewData["Title"] = "Create spaceship";
}

<h1>Create spaceship</h1>

@* Vorm saadab kasutaja sisestatud andmed SpaceshipControlleri Create POST actionile. *@
<form asp-action="Create" asp-controller="Spaceship" method="post">
    @* Siin kuvatakse üldised valideerimisvead. *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* Kosmoselaeva nimi. *@
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    @* Kosmoselaeva tüüp. *@
    <div class="mb-3">
        <label asp-for="ShipType" class="form-label"></label>
        <input asp-for="ShipType" class="form-control" />
        <span asp-validation-for="ShipType" class="text-danger"></span>
    </div>

    @* Meeskonna liikmete arv. *@
    <div class="mb-3">
        <label asp-for="Crew" class="form-label"></label>
        <input asp-for="Crew" class="form-control" />
        <span asp-validation-for="Crew" class="text-danger"></span>
    </div>

    @* Mootori võimsus. *@
    <div class="mb-3">
        <label asp-for="EnginePower" class="form-label"></label>
        <input asp-for="EnginePower" class="form-control" />
        <span asp-validation-for="EnginePower" class="text-danger"></span>
    </div>

    @* Create salvestab kirje, Back to list viib tagasi nimekirja. *@
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" asp-controller="Spaceship" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    @* Lisame kliendipoolse valideerimise JavaScripti. *@
    <partial name="_ValidationScriptsPartial" />
}
