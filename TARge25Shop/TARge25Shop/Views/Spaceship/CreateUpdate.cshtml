@model TARge25Shop.Models.Spaceship.SpaceshipCreateUpdateViewModel
@{
    // Id olemasolu määrab, kas vaade töötab loomise või muutmise režiimis.
    var isUpdate = Model.Id.HasValue && Model.Id.Value != Guid.Empty;

    // Sama pealkiri muutub automaatselt vastavalt vormi töörežiimile.
    ViewData["Title"] = isUpdate ? "Update spaceship" : "Create spaceship";
}

<h1>@ViewData["Title"]</h1>

@* Ühine vorm saadab nii loomise kui ka muutmise andmed CreateUpdate POST actionile. *@
<form asp-action="CreateUpdate" asp-controller="Spaceship" method="post" enctype="multipart/form-data">
    @* Muutmise korral saadame peidetud väljal olemasoleva kosmoselaeva ID. *@
    @if (isUpdate)
    {
        <input asp-for="Id" type="hidden" />
    }

    @* Siin kuvatakse kõik vormi üldised valideerimisvead. *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* Kosmoselaeva nimi. *@
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    @* Kosmoselaeva tüüp. *@
    <div class="mb-3">
        <label asp-for="ShipType" class="form-label"></label>
        <input asp-for="ShipType" class="form-control" />
        <span asp-validation-for="ShipType" class="text-danger"></span>
    </div>

    @* Meeskonnaliikmete arv. *@
    <div class="mb-3">
        <label asp-for="Crew" class="form-label"></label>
        <input asp-for="Crew" class="form-control" />
        <span asp-validation-for="Crew" class="text-danger"></span>
    </div>

    @* Mootori võimsus. *@
    <div class="mb-3">
        <label asp-for="EnginePower" class="form-label"></label>
        <input asp-for="EnginePower" class="form-control" />
        <span asp-validation-for="EnginePower" class="text-danger"></span>
    </div>

    @* Olemasolevaid faile näitame ainult muutmise režiimis. *@
    @if (Model.ExistingImages.Count > 0)
    {
        <fieldset class="mb-3">
            <legend class="fs-6">Existing files</legend>
            @foreach (var image in Model.ExistingImages)
            {
                @* Märkeruut lisab valitud failinime kustutatavate failide nimekirja. *@
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="FileNamesToDelete" value="@image.StoredFileName"
                           id="delete-@image.StoredFileName" />
                    <label class="form-check-label" for="delete-@image.StoredFileName">
                        Delete @image.FileName (@((image.FileSize / 1024d).ToString("0.0")) KB)
                    </label>
                </div>
            }
        </fieldset>
    }

    @* Multiple atribuut võimaldab valida korraga mitu uut faili. *@
    <div class="mb-3">
        <label asp-for="Files" class="form-label"></label>
        <input asp-for="Files" class="form-control" type="file" multiple />
        <div class="form-text">Up to 10 MB per file and 25 MB in total.</div>
        <span asp-validation-for="Files" class="text-danger"></span>
    </div>

    @* Nupu tekst näitab, kas vorm loob uue kirje või salvestab muudatused. *@
    <button type="submit" class="btn btn-primary">@(isUpdate ? "Save" : "Create")</button>
    <a asp-action="Index" asp-controller="Spaceship" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    @* Lisame kliendipoolse valideerimise JavaScripti. *@
    <partial name="_ValidationScriptsPartial" />
}
