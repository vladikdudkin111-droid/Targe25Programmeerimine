@model TARge25Shop.Models.Spaceship.SpaceshipUpdateViewModel
@{
    // Lehe pealkiri brauseris.
    ViewData["Title"] = "Update spaceship";
}

<h1>Update spaceship</h1>

@* Vorm saadab muudetud andmed SpaceshipControlleri Update POST actionile. *@
<form asp-action="Update" asp-controller="Spaceship" method="post">
    @* ID on peidetud väli, et Controller teaks, millist kirjet muuta. *@
    <input asp-for="Id" type="hidden" />

    @* Siin kuvatakse üldised valideerimisvead. *@
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    @* Kosmoselaeva nimi. *@
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    @* Kosmoselaeva tüüp. *@
    <div class="mb-3">
        <label asp-for="ShipType" class="form-label"></label>
        <input asp-for="ShipType" class="form-control" />
        <span asp-validation-for="ShipType" class="text-danger"></span>
    </div>

    @* Meeskonna liikmete arv. *@
    <div class="mb-3">
        <label asp-for="Crew" class="form-label"></label>
        <input asp-for="Crew" class="form-control" />
        <span asp-validation-for="Crew" class="text-danger"></span>
    </div>

    @* Mootori võimsus. *@
    <div class="mb-3">
        <label asp-for="EnginePower" class="form-label"></label>
        <input asp-for="EnginePower" class="form-control" />
        <span asp-validation-for="EnginePower" class="text-danger"></span>
    </div>

    @* Save salvestab muudatused, Back to list jätab lehe muutmata. *@
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</form>

@section Scripts {
    @* Lisame kliendipoolse valideerimise JavaScripti. *@
    <partial name="_ValidationScriptsPartial" />
}
