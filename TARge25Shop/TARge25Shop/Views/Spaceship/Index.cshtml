@model IEnumerable<TARge25Shop.Models.Spaceship.SpaceshipIndexViewModel>

@{
    // Reanumber on ainult tabelis kuvamiseks ega kuulu andmebaasi.
    ViewData["Title"] = "Spaceships";
    var rowNumber = 1;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Spaceships</h1>
    <!-- Link avab Create GET tegevuse. -->
    <a asp-action="Create" class="btn btn-primary">Create</a>
</div>

<!-- Tabel kuvab kõik Controllerist saadud ViewModelid. -->
<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th scope="col">Nr</th>
            <th scope="col">Name</th>
            <th scope="col">Type</th>
            <th scope="col">Built date</th>
            <th scope="col">Crew</th>
            <th scope="col">Engine power</th>
            <th scope="col">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var spaceship in Model)
        {
            <tr>
                <td>@rowNumber</td>
                <td>@spaceship.Name</td>
                <td>@spaceship.ShipType</td>
                <td>@spaceship.CreatedAt</td>
                <td>@spaceship.Crew</td>
                <td>@spaceship.EnginePower</td>
                <td class="text-nowrap">
                    <!-- Kõik tegevused saavad valitud rea ID route parameetrina. -->
                    <a asp-action="Details" asp-route-id="@spaceship.Id" class="btn btn-sm btn-primary">Details</a>
                    <a asp-action="Update" asp-route-id="@spaceship.Id" class="btn btn-sm btn-primary">Update</a>
                    <a asp-action="Delete" asp-route-id="@spaceship.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                </td>
            </tr>

            rowNumber++;
        }
    </tbody>
</table>
