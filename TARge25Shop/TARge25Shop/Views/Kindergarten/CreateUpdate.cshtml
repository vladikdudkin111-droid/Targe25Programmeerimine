@model TARge25Shop.Models.Kindergarten.KindergartenCreateUpdateViewModel
@{
    // ID järgi otsustame, kas loome uue rühma või muudame olemasolevat.
    var isUpdate = Model.Id != Guid.Empty;
    var action = isUpdate ? "Update" : "Create";
    ViewData["Title"] = action + " kindergarten group";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Kindergarten" asp-action="@action" asp-route-id="@(isUpdate ? Model.Id.ToString() : null)" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" type="hidden" />

            <div class="mb-3">
                <label asp-for="GroupName" class="form-label"></label>
                <input asp-for="GroupName" class="form-control" />
                <span asp-validation-for="GroupName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ChildrenCount" class="form-label"></label>
                <input asp-for="ChildrenCount" class="form-control" min="0" />
                <span asp-validation-for="ChildrenCount" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="KindergartenName" class="form-label"></label>
                <input asp-for="KindergartenName" class="form-control" />
                <span asp-validation-for="KindergartenName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TeacherName" class="form-label"></label>
                <input asp-for="TeacherName" class="form-control" />
                <span asp-validation-for="TeacherName" class="text-danger"></span>
            </div>

            @* Kuupäevad määrab teenus automaatselt. *@
            <div class="mb-3">
                <label asp-for="Files" class="form-label"></label>
                <input asp-for="Files" type="file" multiple accept=".jpg,.jpeg,.png,.gif,.webp" class="form-control" aria-describedby="image-help" />
                <div id="image-help" class="form-text">JPG, PNG, GIF or WebP. Up to 10 images per upload, 5 MB each, 20 MB total. Existing images are kept.</div>
                <span asp-validation-for="Files" class="text-danger"></span>
                @if (ViewData.ModelState.ErrorCount > 0)
                {
                    <div class="form-text">Please select your new images again before saving.</div>
                }
            </div>
            <button type="submit" class="btn btn-primary">@action</button>
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        </form>
    </div>
</div>

@if (isUpdate)
{
    <partial name="_Images" model="Model.Gallery" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
