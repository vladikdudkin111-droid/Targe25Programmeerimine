@model TARge25Shop.Models.Kindergarten.KindergartenCreateUpdateViewModel
@{
    // ID järgi otsustame, kas loome uue rühma või muudame olemasolevat.
    var isUpdate = Model.Id != Guid.Empty;
    var action = isUpdate ? "Update" : "Create";
    ViewData["Title"] = action + " kindergarten group";
}

<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Kindergarten" asp-action="@action" asp-route-id="@(isUpdate ? Model.Id.ToString() : null)" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" type="hidden" />

            <div class="mb-3">
                <label asp-for="GroupName" class="form-label"></label>
                <input asp-for="GroupName" class="form-control" />
                <span asp-validation-for="GroupName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ChildrenCount" class="form-label"></label>
                <input asp-for="ChildrenCount" class="form-control" min="0" />
                <span asp-validation-for="ChildrenCount" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="KindergartenName" class="form-label"></label>
                <input asp-for="KindergartenName" class="form-control" />
                <span asp-validation-for="KindergartenName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="TeacherName" class="form-label"></label>
                <input asp-for="TeacherName" class="form-control" />
                <span asp-validation-for="TeacherName" class="text-danger"></span>
            </div>

            @* Kuupäevad määrab teenus automaatselt. *@
            <button type="submit" class="btn btn-primary">@action</button>
            <a asp-action="Index" class="btn btn-secondary">Back to list</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
