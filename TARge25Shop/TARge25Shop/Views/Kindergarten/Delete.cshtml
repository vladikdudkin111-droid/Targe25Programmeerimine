@model TARge25Shop.Models.Kindergarten.KindergartenDeleteViewModel
@{
    ViewData["Title"] = "Delete kindergarten group";
}
<h1>Delete</h1>
<p class="text-danger">Are you sure you want to delete this kindergarten group?</p>
<p class="text-danger">All images attached to this group will also be deleted.</p>
<dl class="row">
    <dt class="col-sm-3">Id</dt>
    <dd class="col-sm-9">@Model.Id</dd>
    <dt class="col-sm-3">Group name</dt>
    <dd class="col-sm-9">@Model.GroupName</dd>
    <dt class="col-sm-3">Children count</dt>
    <dd class="col-sm-9">@Model.ChildrenCount</dd>
    <dt class="col-sm-3">Kindergarten name</dt>
    <dd class="col-sm-9">@Model.KindergartenName</dd>
    <dt class="col-sm-3">Teacher name</dt>
    <dd class="col-sm-9">@Model.TeacherName</dd>
    <dt class="col-sm-3">Created at</dt>
    <dd class="col-sm-9">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm:ss")</dd>
    <dt class="col-sm-3">Updated at</dt>
    <dd class="col-sm-9">@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm:ss")</dd>
</dl>
<partial name="_Images" model="Model.Gallery" />
@* Kustutame alles pärast POST-vormi saatmist. *@
<form asp-action="DeleteConfirmation" asp-controller="Kindergarten" method="post">
    <input asp-for="Id" type="hidden" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to list</a>
</form>
