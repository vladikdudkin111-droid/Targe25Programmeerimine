@model IEnumerable<TARge25Shop.Models.Kindergarten.KindergartenIndexViewModel>
@{
    ViewData["Title"] = "Kindergarten";
    var nr = 1;
}

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">Create</a>
</div>
<h1>Kindergarten groups</h1>

@* Tabel kuvab rühmad ja iga kirje tegevusnupud. *@
<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th scope="col">Nr</th>
                <th scope="col">Group name</th>
                <th scope="col">Children count</th>
                <th scope="col">Kindergarten name</th>
                <th scope="col">Teacher name</th>
                <th scope="col">Created at</th>
                <th scope="col">Updated at</th>
                <th scope="col">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kindergarten in Model)
            {
                <tr>
                    <td>@(nr++)</td>
                    <td>@kindergarten.GroupName</td>
                    <td>@kindergarten.ChildrenCount</td>
                    <td>@kindergarten.KindergartenName</td>
                    <td>@kindergarten.TeacherName</td>
                    <td>@kindergarten.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@kindergarten.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@kindergarten.Id" class="btn btn-primary btn-sm">Details</a>
                        <a asp-action="Update" asp-route-id="@kindergarten.Id" class="btn btn-primary btn-sm">Update</a>
                        <a asp-action="Delete" asp-route-id="@kindergarten.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (!Model.Any())
{
    <div class="alert alert-info">No kindergarten groups have been created yet.</div>
}
